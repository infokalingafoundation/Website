<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kalinga Research and Technology Foundation (KRTF)</title>
<meta name="description" content="Kalinga Research and Technology Foundation — governing body of KRTC, advancing research, education and technology across Odisha since 2016.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0A2342;
    --navy-2:#0d2d55;
    --teal:#0E7490;
    --amber:#F59E0B;
    --amber-2:#FBBF24;
    --white:#FFFFFF;
    --off-white:#F8FAFC;
    --muted-blue:#93C5FD;
    --bg-light:#F9FAFB;
    --bg-dark:#030712;
    --ink:#0f172a;
    --ink-soft:#475569;
    --radius-lg:24px;
    --radius-md:16px;
    --shadow-teal:0 20px 60px rgba(14,116,144,0.20);
    --shadow-amber:0 16px 40px rgba(245,158,11,0.25);
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  body{
    font-family:'Inter', sans-serif;
    background:var(--bg-light);
    color:var(--ink);
    line-height:1.6;
    overflow-x:hidden;
    transition:background .4s ease, color .4s ease;
  }
  body.dark{
    background:var(--bg-dark);
    color:var(--off-white);
  }

  h1,h2,h3,h4{font-family:'Poppins', sans-serif; line-height:1.15; letter-spacing:-0.02em;}

  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  ul{list-style:none;}
  button{font-family:inherit; cursor:pointer; border:none; background:none;}

  .container{max-width:1220px; margin:0 auto; padding:0 24px;}
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:13px; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    color:var(--teal); background:rgba(14,116,144,0.09);
    padding:7px 16px; border-radius:100px; margin-bottom:18px;
  }
  body.dark .eyebrow{ color:var(--amber-2); background:rgba(245,158,11,0.10); }

  .grad-text{
    background:linear-gradient(90deg, var(--amber) 0%, var(--amber-2) 45%, #FDE68A 70%, var(--amber) 100%);
    background-size:300% auto;
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:transparent;
    animation:gradShift 6s linear infinite;
  }
  @keyframes gradShift{ to{ background-position:300% center; } }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:15px 30px; border-radius:100px; font-weight:600; font-size:15px;
    transition:transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, background .3s ease;
    white-space:nowrap;
  }
  .btn-amber{
    background:linear-gradient(135deg, var(--amber-2), var(--amber));
    color:var(--navy); box-shadow:var(--shadow-amber);
  }
  .btn-amber:hover{ transform:translateY(-4px); box-shadow:0 22px 50px rgba(245,158,11,0.38); }
  .btn-glass{
    background:rgba(255,255,255,0.08); color:#fff; border:1px solid rgba(255,255,255,0.35);
    backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  }
  .btn-glass:hover{ transform:translateY(-4px); background:rgba(255,255,255,0.16); }

  /* Scroll progress */
  #scrollbar{
    position:fixed; top:0; left:0; height:3px; width:0%;
    background:linear-gradient(90deg, var(--amber), var(--amber-2));
    z-index:9999; transition:width .1s linear;
  }

  /* NAVBAR */
  header{
    position:fixed; top:0; left:0; right:0; z-index:1000;
    padding:18px 0; transition:all .4s cubic-bezier(.2,.8,.2,1);
  }
  header.scrolled{
    padding:12px 0;
    background:rgba(255,255,255,0.85);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    box-shadow:0 4px 24px rgba(10,35,66,0.08);
  }
  body.dark header.scrolled{
    background:rgba(10,35,66,0.85);
    box-shadow:0 4px 24px rgba(0,0,0,0.4);
  }
  .nav-inner{display:flex; align-items:center; justify-content:space-between; gap:20px;}
  .logo-wrap{display:flex; align-items:center; gap:12px;}
  .logo-badge{
    display:flex; font-family:'Poppins',sans-serif; font-weight:800; font-size:17px; border-radius:10px; overflow:hidden;
    box-shadow:0 6px 18px rgba(10,35,66,0.25);
  }
  .logo-badge span{padding:9px 8px;}
  .logo-badge .kr{background:var(--navy); color:#fff;}
  .logo-badge .tf{background:linear-gradient(135deg,var(--amber-2),var(--amber)); color:var(--navy);}
  .logo-text-full{display:flex; flex-direction:column; line-height:1.2;}
  .logo-text-full strong{font-family:'Poppins',sans-serif; font-size:15px; font-weight:700; color:var(--navy);}
  body.dark .logo-text-full strong{color:#fff;}
  .logo-text-full small{font-size:11px; color:var(--ink-soft); font-weight:500;}
  body.dark .logo-text-full small{color:var(--muted-blue);}

  .nav-links{display:flex; align-items:center; gap:34px;}
  .nav-links a{font-size:14.5px; font-weight:600; color:var(--ink); position:relative; padding:4px 0;}
  body.dark .nav-links a{color:var(--off-white);}
  .nav-links a::after{
    content:''; position:absolute; left:0; bottom:-2px; width:0; height:2px;
    background:var(--amber); transition:width .3s ease;
  }
  .nav-links a:hover::after{width:100%;}

  .nav-actions{display:flex; align-items:center; gap:14px;}
  .mode-toggle{
    width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:rgba(14,116,144,0.1); font-size:17px; transition:transform .3s ease, background .3s ease;
  }
  .mode-toggle:hover{transform:rotate(20deg) scale(1.08); background:rgba(14,116,144,0.2);}
  .burger{display:none; width:40px; height:40px; border-radius:10px; flex-direction:column; justify-content:center; align-items:center; gap:5px;}
  .burger span{width:22px; height:2px; background:var(--navy); border-radius:2px; transition:.3s;}
  body.dark .burger span{background:#fff;}

  .mobile-menu{
    display:none; position:fixed; top:70px; left:16px; right:16px; z-index:999;
    background:var(--off-white); border-radius:18px; padding:22px; box-shadow:0 20px 50px rgba(0,0,0,.2);
    max-height:0; overflow:hidden; opacity:0; transition:max-height .4s ease, opacity .3s ease, padding .4s ease;
  }
  body.dark .mobile-menu{background:#0d1b30;}
  .mobile-menu.open{max-height:420px; opacity:1;}
  .mobile-menu a{display:block; padding:12px 4px; font-weight:600; font-size:15px; border-bottom:1px solid rgba(148,163,184,.15);}

  @media (max-width:920px){
    .nav-links{display:none;}
    .burger{display:flex;}
    .mobile-menu{display:block;}
  }

  /* HERO */
  .hero{
    position:relative; min-height:100vh; display:flex; align-items:center;
    background:linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 50%, var(--teal) 100%);
    overflow:hidden; padding:130px 0 80px;
  }
  .hero .grid-overlay{
    position:absolute; inset:0; opacity:.14;
    background-image:radial-gradient(rgba(255,255,255,.7) 1px, transparent 1px);
    background-size:26px 26px;
  }
  .orb{position:absolute; border-radius:50%; filter:blur(70px); opacity:.55; animation:floatOrb 9s ease-in-out infinite;}
  .orb1{width:380px; height:380px; background:var(--amber); top:-100px; right:-80px; animation-delay:0s;}
  .orb2{width:340px; height:340px; background:var(--teal); bottom:-120px; left:-100px; animation-delay:2s;}
  .orb3{width:220px; height:220px; background:#3b82f6; top:40%; right:20%; animation-delay:4s; opacity:.3;}
  @keyframes floatOrb{ 0%,100%{transform:scale(1) translateY(0);} 50%{transform:scale(1.18) translateY(-30px);} }

  .sparkle{position:absolute; width:5px; height:5px; background:var(--amber-2); border-radius:50%; box-shadow:0 0 10px 2px rgba(245,158,11,.8); animation:sparkleFloat 5s ease-in-out infinite;}
  @keyframes sparkleFloat{ 0%,100%{transform:translateY(0); opacity:.3;} 50%{transform:translateY(-24px); opacity:1;} }

  .hero-inner{position:relative; z-index:3; display:grid; grid-template-columns:1.15fr .85fr; gap:56px; align-items:center;}
  @media (max-width:980px){ .hero-inner{grid-template-columns:1fr;} }

  .pulse-dot{
    width:8px; height:8px; border-radius:50%; background:var(--amber-2);
    box-shadow:0 0 0 0 rgba(245,158,11,.7); animation:pulseDot 1.8s infinite;
  }
  @keyframes pulseDot{
    0%{box-shadow:0 0 0 0 rgba(245,158,11,.6);}
    70%{box-shadow:0 0 0 9px rgba(245,158,11,0);}
    100%{box-shadow:0 0 0 0 rgba(245,158,11,0);}
  }
  .hero-badge{
    display:inline-flex; align-items:center; gap:9px; background:rgba(245,158,11,.12);
    border:1px solid rgba(245,158,11,.4); color:var(--amber-2); font-size:13px; font-weight:600;
    padding:8px 18px 8px 14px; border-radius:100px; margin-bottom:26px;
  }
  .hero h1{font-size:clamp(2.4rem, 5vw, 3.9rem); color:#fff; font-weight:800; margin-bottom:22px;}
  .hero p.lead{color:var(--muted-blue); font-size:17.5px; max-width:560px; margin-bottom:34px;}
  .hero-cta{display:flex; gap:16px; flex-wrap:wrap; margin-bottom:10px;}

  .feature-card{
    position:relative; background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16);
    backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
    border-radius:var(--radius-lg); padding:34px; box-shadow:var(--shadow-teal);
    overflow:hidden;
  }
  .feature-card::before{
    content:''; position:absolute; top:0; left:-150%; width:60%; height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
    transform:skewX(-20deg); animation:shimmer 4.5s ease-in-out infinite;
  }
  @keyframes shimmer{ 0%{left:-150%;} 55%,100%{left:150%;} }
  .feature-card h4{color:#fff; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; margin-bottom:22px; opacity:.75;}
  .feature-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
  .feature-stat{background:rgba(255,255,255,.05); border-radius:14px; padding:18px 16px; border:1px solid rgba(255,255,255,.08);}
  .feature-stat .num{font-family:'Poppins',sans-serif; font-size:26px; font-weight:800; color:#fff;}
  .feature-stat .lbl{font-size:12.5px; color:var(--muted-blue); margin-top:4px;}

  /* Section shared */
  section{padding:100px 0; position:relative;}
  .reveal{opacity:0; transform:translateY(40px); transition:opacity .8s cubic-bezier(.2,.7,.3,1), transform .8s cubic-bezier(.2,.7,.3,1);}
  .reveal.in{opacity:1; transform:translateY(0);}
  .sec-head{max-width:640px; margin-bottom:56px;}
  .sec-head.center{margin-left:auto; margin-right:auto; text-align:center;}
  .sec-head h2{font-size:clamp(1.7rem,3.4vw,2.5rem); font-weight:700; color:var(--navy);}
  body.dark .sec-head h2{color:#fff;}
  .sec-head p{color:var(--ink-soft); font-size:16px; margin-top:14px;}
  body.dark .sec-head p{color:var(--muted-blue);}

  /* STATS BAR */
  .stats-bar{background:var(--navy); position:relative; overflow:hidden;}
  .stats-bar::before{content:''; position:absolute; inset:0; background:radial-gradient(circle at 20% 20%, rgba(14,116,144,.35), transparent 60%);}
  .stats-grid{position:relative; z-index:2; display:grid; grid-template-columns:repeat(4,1fr); }
  .stat-item{padding:0 28px; text-align:center; position:relative;}
  .stat-item + .stat-item::before{content:''; position:absolute; left:0; top:10%; bottom:10%; width:1px; background:rgba(255,255,255,.15);}
  .stat-item .ic{font-size:26px; margin-bottom:10px;}
  .stat-item .num{font-family:'Poppins',sans-serif; font-weight:800; font-size:clamp(1.8rem,3vw,2.6rem); color:#fff;}
  .stat-item .lbl{color:var(--amber-2); font-weight:600; font-size:14.5px; margin-top:6px;}
  .stat-item .desc{color:var(--muted-blue); font-size:12.5px; margin-top:6px;}
  @media (max-width:800px){ .stats-grid{grid-template-columns:1fr 1fr; row-gap:40px;} .stat-item + .stat-item::before{display:none;} }

  /* ABOUT */
  .about-grid{display:grid; grid-template-columns:.85fr 1.15fr; gap:60px; align-items:center;}
  @media (max-width:920px){ .about-grid{grid-template-columns:1fr;} }
  .found-card{
    background:linear-gradient(160deg, var(--navy), var(--navy-2));
    border-radius:var(--radius-lg); padding:40px 32px; color:#fff; box-shadow:var(--shadow-teal);
    position:relative; overflow:hidden;
  }
  .found-card::after{content:''; position:absolute; width:220px; height:220px; background:var(--teal); filter:blur(70px); opacity:.4; bottom:-60px; right:-60px; border-radius:50%;}
  .found-mono{
    width:74px; height:74px; border-radius:18px; background:linear-gradient(135deg,var(--amber-2),var(--amber));
    display:flex; align-items:center; justify-content:center; font-family:'Poppins',sans-serif; font-weight:800;
    color:var(--navy); font-size:22px; margin-bottom:22px; position:relative; z-index:2;
  }
  .found-card h3{font-size:20px; margin-bottom:6px; position:relative; z-index:2;}
  .found-card .sub{color:var(--muted-blue); font-size:13.5px; margin-bottom:24px; position:relative; z-index:2;}
  .badge-list{display:flex; flex-wrap:wrap; gap:10px; position:relative; z-index:2;}
  .badge-pill{font-size:12.5px; font-weight:600; padding:7px 13px; border-radius:100px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);}

  .about-text h2{color:var(--navy); margin-bottom:18px;}
  body.dark .about-text h2{color:#fff;}
  .about-text > p{color:var(--ink-soft); margin-bottom:26px; font-size:16px;}
  body.dark .about-text > p{color:var(--muted-blue);}
  .role-list{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  .role-list li{display:flex; align-items:center; gap:10px; font-weight:600; font-size:14.5px; color:var(--navy);}
  body.dark .role-list li{color:#fff;}
  .role-list li .tick{color:var(--teal); font-size:16px;}
  @media (max-width:560px){ .role-list{grid-template-columns:1fr;} }

  /* INITIATIVES */
  .initiatives{background:linear-gradient(180deg, var(--navy), var(--navy-2));}
  .initiatives .sec-head h2, .initiatives .sec-head p{color:#fff;}
  .initiatives .sec-head p{color:var(--muted-blue);}
  .krtc-card{
    display:grid; grid-template-columns:.9fr 1.1fr; border-radius:var(--radius-lg); overflow:hidden;
    box-shadow:var(--shadow-teal); margin-bottom:44px;
  }
  @media (max-width:860px){ .krtc-card{grid-template-columns:1fr;} }
  .krtc-left{
    background:linear-gradient(150deg, #08182e, var(--navy)); padding:44px 38px; color:#fff; position:relative;
    display:flex; flex-direction:column; justify-content:center;
  }
  .krtc-left .kname{font-family:'Poppins',sans-serif; font-weight:800; font-size:30px; margin-bottom:8px;}
  .krtc-left .ktag{color:var(--amber-2); font-weight:600; font-size:14.5px; margin-bottom:22px;}
  .krtc-left .kcats{display:flex; flex-wrap:wrap; gap:8px;}
  .krtc-left .kcats span{font-size:12px; font-weight:600; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16); padding:6px 12px; border-radius:100px;}
  .krtc-right{background:rgba(255,255,255,.04); padding:38px; display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .kfeat{background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); border-radius:14px; padding:16px 14px; transition:transform .3s ease, border-color .3s ease;}
  .kfeat:hover{transform:translateY(-4px); border-color:rgba(245,158,11,.5);}
  .kfeat .ic{font-size:20px; margin-bottom:8px;}
  .kfeat p{color:#fff; font-size:13.5px; font-weight:600;}

  .krtc-cta{text-align:center; margin-bottom:50px;}

  .cat-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
  @media (max-width:800px){ .cat-grid{grid-template-columns:1fr;} }
  .cat-card{
    background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12); backdrop-filter:blur(10px);
    border-radius:var(--radius-md); padding:28px; transition:transform .35s ease, border-color .35s ease;
  }
  .cat-card:hover{transform:translateY(-6px); border-color:var(--amber);}
  .cat-card .ic{font-size:26px; margin-bottom:14px;}
  .cat-card h4{color:#fff; font-size:17px; margin-bottom:8px;}
  .cat-card p{color:var(--muted-blue); font-size:13.5px;}

  /* PROGRAMS */
  .prog-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:26px;}
  @media (max-width:900px){ .prog-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:600px){ .prog-grid{grid-template-columns:1fr;} }
  .prog-card{
    background:#fff; border:1px solid #E5EAF2; border-radius:var(--radius-md); padding:28px;
    box-shadow:0 8px 24px rgba(10,35,66,.05); transition:transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    position:relative; overflow:hidden;
  }
  body.dark .prog-card{background:#0d1b30; border-color:rgba(255,255,255,.08);}
  .prog-card::before{content:''; position:absolute; top:0; left:-150%; width:50%; height:100%; background:linear-gradient(120deg, transparent, rgba(245,158,11,.14), transparent); transform:skewX(-20deg); transition:left .6s ease;}
  .prog-card:hover::before{left:150%;}
  .prog-card:hover{transform:translateY(-6px); box-shadow:0 20px 44px rgba(10,35,66,.12); border-color:var(--amber);}
  .prog-card .ic{font-size:28px; margin-bottom:14px;}
  .prog-card h4{font-size:17px; color:var(--navy); margin-bottom:10px;}
  body.dark .prog-card h4{color:#fff;}
  .prog-card .meta{font-size:12.5px; color:var(--ink-soft); margin-bottom:16px;}
  body.dark .prog-card .meta{color:var(--muted-blue);}
  .prog-card .learn{font-size:13.5px; font-weight:700; color:var(--amber);}

  /* CERTIFICATIONS */
  .cert-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:22px;}
  @media (max-width:900px){ .cert-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:520px){ .cert-grid{grid-template-columns:1fr;} }
  .cert-card{
    background:#fff; border-radius:var(--radius-md); padding:26px; text-align:center;
    border:1px solid #E5EAF2; box-shadow:0 8px 24px rgba(10,35,66,.05);
    transition:transform .35s ease, box-shadow .35s ease;
  }
  body.dark .cert-card{background:#0d1b30; border-color:rgba(255,255,255,.08);}
  .cert-card:hover{transform:translateY(-6px); box-shadow:0 20px 44px rgba(10,35,66,.12);}
  .cert-card .ic{font-size:30px; margin-bottom:12px;}
  .cert-card h4{font-size:15.5px; color:var(--navy); margin-bottom:4px;}
  body.dark .cert-card h4{color:#fff;}
  .cert-card .subt{font-size:12.5px; color:var(--ink-soft); margin-bottom:12px;}
  body.dark .cert-card .subt{color:var(--muted-blue);}
  .cert-card p.d{font-size:12.5px; color:var(--ink-soft); margin-bottom:14px;}
  body.dark .cert-card p.d{color:var(--muted-blue);}
  .status-pill{display:inline-block; font-size:11.5px; font-weight:700; padding:5px 12px; border-radius:100px;}
  .status-pill.cert{background:rgba(14,116,144,.12); color:var(--teal);}
  .status-pill.reg{background:rgba(245,158,11,.14); color:#b45309;}
  .status-pill.rec{background:rgba(16,185,129,.12); color:#059669;}
  body.dark .status-pill.reg{color:var(--amber-2);}

  /* KRTC PREVIEW */
  .preview-sec{background:var(--bg-dark);}
  .preview-sec .sec-head h2{color:#fff;}
  .preview-sec .sec-head p{color:var(--muted-blue);}
  .browser-frame{
    max-width:820px; margin:0 auto; border-radius:18px; overflow:hidden;
    box-shadow:0 40px 100px rgba(14,116,144,.35), 0 0 0 1px rgba(255,255,255,.06);
    position:relative;
  }
  .browser-frame::before{
    content:''; position:absolute; inset:-40px; background:radial-gradient(circle, rgba(14,116,144,.35), transparent 65%); z-index:-1;
  }
  .browser-top{background:#111827; padding:12px 16px; display:flex; align-items:center; gap:14px;}
  .dots{display:flex; gap:7px;}
  .dots span{width:11px; height:11px; border-radius:50%;}
  .dots .r{background:#f87171;} .dots .y{background:#fbbf24;} .dots .g{background:#34d399;}
  .url-bar{flex:1; background:#1f2937; color:#9CA3AF; font-size:12.5px; padding:6px 14px; border-radius:8px; font-family:'Inter',sans-serif;}
  .browser-body{
    background:linear-gradient(135deg, var(--navy), var(--navy-2), var(--teal));
    padding:60px 30px; text-align:center;
  }
  .browser-body h3{color:#fff; font-size:clamp(1.3rem,3vw,1.9rem); margin-bottom:22px;}
  .mini-badges{display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin-bottom:26px;}
